# Project-level npm overrides.
# Global ~/.npmrc provides the hardened baseline; this file restates
# policies that MUST travel with the repo (CI, containers, teammates).

# Supply-chain defense: refuse packages published < 7 days ago.
# Escape hatch for emergency patches: `npm install <pkg> --min-release-age=0`.
# See Technology/Security/npm Supply Chain Security.md for rationale.
min-release-age=7
